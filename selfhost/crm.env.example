# Copy to /opt/crm-proxy/crm.env on the server and fill in. Never commit the real file.
# SUPABASE_URL  = the public address staff use (same as SUPABASE_PUBLIC_URL in Supabase's .env)
# SUPABASE_KEY  = the publishable key shown by `sh run.sh secrets`. This one is meant to be public;
#                 NEVER put the secret/service key here.
SUPABASE_URL=https://crm.maqint.com
SUPABASE_KEY=
